# Copy to .env — values here are NEVER logged or returned by any API endpoint.

# Optional: token that remote callers must supply to reach the local service.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to auto-generate a fresh token each process start (recommended).
VFW_SERVICE_TOKEN=

# Optional: Hugging Face token for private model downloads.
HF_TOKEN=
